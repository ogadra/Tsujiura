# S3 bucket that holds the Terraform state of both terraform/aws and terraform/google-cloud.
TF_BACKEND_BUCKET=

AWS_PROFILE=
AWS_REGION=

# The google provider reads GOOGLE_PROJECT first, then GOOGLE_CLOUD_PROJECT.
GOOGLE_CLOUD_PROJECT=
GOOGLE_PROJECT=

# Project and account gcloud itself operates as.
CLOUDSDK_CORE_PROJECT=
CLOUDSDK_CORE_ACCOUNT=
